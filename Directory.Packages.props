<Project>
  <ItemGroup>
    <!-- API + CQRS -->
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0" />

    <!-- Persistence -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.31" />
    <!-- Relational metadata only (schema, table/column names, indexes): ready for a SQL provider swap. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />

    <!-- Tests -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.31" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
